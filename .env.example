# Gere valores hexadecimais com: python3 scripts/setup_env.py
POSTGRES_PASSWORD=
SIGNING_KEY=
PORT=8080
PUBLIC_URL=http://localhost:8080
SITE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Apenas desenvolvimento local. Em produção: false + SMTP.
DEV_AUTO_CONFIRM=true
STORAGE_QUOTA_BYTES=536870912
ANTHROPIC_API_KEY=
# Selecione um modelo de visão com suporte a JSON estruturado, disponível na sua conta.
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
# Para chat Opus 5 com thinking, use por exemplo 2048.
CHAT_MAX_TOKENS=600
FACTS_MODEL=claude-haiku-4-5
CHAT_MODEL=claude-haiku-4-5
SEARCH_MODEL=claude-haiku-4-5
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_MIN_INTERVAL_SECONDS=60
# Login Google independente de Supabase. Habilite após configurar um cliente Web.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/v1/auth/google/callback
GOOGLE_RETURN_URLS=broto://auth-callback

# AWS only: local Compose keeps filesystem storage.
STORAGE_BUCKET=
AWS_REGION=sa-east-1
CLOUDFRONT_URL=
CLOUDFRONT_KEY_ID=
CLOUDFRONT_PRIVATE_KEY=
DB_MAX_CONNS=10
MAX_CONCURRENT_REQUESTS=24
AUTO_MIGRATE=true
TRUSTED_PROXY_CIDRS=
